{
  "appId": "ru.termburg.workstation.portable",
  "productName": "Термбург Рабочее место",
  "asar": true,
  "compression": "normal",
  "directories": {
    "output": "release/workstation-portable",
    "buildResources": "desktop/assets"
  },
  "files": [
    "desktop/**/*",
    "workstation/**/*",
    "dolphin-agent/core/**/*",
    "dolphin-agent/adapters/excel-reader.ps1",
    "server/schedule-auth.mjs",
    "server/schedule-service.mjs",
    "server/schedule-server.mjs",
    "server/wordpress-schedule.mjs",
    "frontend/build/**/*",
    "frontend/public/data/default-schedule.json",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dolphin-agent/adapters/excel-reader.ps1",
      "to": "workstation/excel-reader.ps1"
    }
  ],
  "extraMetadata": {
    "main": "desktop/main.mjs",
    "version": "1.1.3",
    "description": "Portable-версия рабочего места Термбург с Dolphin"
  },
  "win": {
    "target": [
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "desktop/assets/icon.png",
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": {
    "artifactName": "Termburg-Workstation-Portable-${version}.${ext}"
  }
}
