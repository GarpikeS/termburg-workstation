[Unit]
Description=Termliny feedback API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
UMask=0027
WorkingDirectory=/opt/termliny-feedback
Environment=NODE_ENV=production
Environment=FEEDBACK_HOST=127.0.0.1
Environment=FEEDBACK_PORT=4175
Environment=FEEDBACK_DATA_FILE=/var/lib/termliny-game/feedback.jsonl
Environment=REWARD_CLAIMS_DATA_FILE=/var/lib/termliny-game/reward-claims.jsonl
Environment=REWARD_REDEMPTIONS_DATA_FILE=/var/lib/termliny-game/reward-redemptions.jsonl
Environment=DOLPHIN_CONNECTORS_DATA_FILE=/var/lib/termliny-game/dolphin-connectors.json
Environment=AUTH_DATA_FILE=/var/lib/termliny-game/accounts.sqlite
Environment=AUTH_COOKIE_SECURE=1
Environment=AUTH_LEGACY_COIN_CAP=600
Environment=FEEDBACK_ALLOWED_ORIGIN=https://tbgame.ru
EnvironmentFile=-/etc/termliny-game/feedback.env
ExecStart=/usr/bin/node /opt/termliny-feedback/feedback-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/termliny-game

[Install]
WantedBy=multi-user.target
