# Keep this file secret in production; never commit real values.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional hidden game profile. Keep the real password only in production env.
TEST_PROFILE_USERNAME=replace-with-test-login
TEST_PROFILE_PASSWORD=replace-with-test-password
TEST_PROFILE_NAME=Тестовый профиль
TEST_PROFILE_CITY=Москва

# Existing production integrations.
CASHIER_EXPORT_TOKEN=replace-with-cashier-export-token
REWARD_ADMIN_TOKEN=replace-with-separate-redemption-import-token
DOLPHIN_CONNECTOR_TOKEN=replace-with-separate-dolphin-agent-token
DOLPHIN_ENROLLMENT_TOKEN_HASH=replace-with-sha256-of-one-time-installer-token
# Bound by the server at enrollment; the Workstation cannot choose its dashboard scope.
DOLPHIN_ENROLLMENT_LOCATION_CODE=moscow
# Separate loopback-only credential shared with the owner dashboard service.
# Generate in production with: openssl rand -hex 32
DOLPHIN_BUSINESS_INTERNAL_TOKEN=replace-with-separate-64-character-hex-token
DOLPHIN_BUSINESS_SUMMARIES_DATA_FILE=/var/lib/termliny-game/dolphin-business-summaries.json
DOLPHIN_SOURCE_API_KEY=replace-with-dolphin-local-api-key
DOLPHIN_SOURCE_API_URLS=http://127.0.0.1:60888,http://10.10.0.250:60888
DOLPHIN_SOURCE_API_PATH=/api/v1/barcodes/game
# Keep 0 until the local API schema has been verified through the agent heartbeat.
DOLPHIN_SOURCE_APPLY=0
DOLPHIN_SOURCE_LOOKBACK_DAYS=2
# Diagnostic-only CAMP probe. The workstation transmits field names/types and counts, never row values.
DOLPHIN_CAMP_SOURCE_ENABLED=0
DOLPHIN_CAMP_INITIAL_DATE=2023-09-01
DOLPHIN_CAMP_GUESTTYPES_PATH=/api/v1/camp/guesttypes
DOLPHIN_CAMP_SERVICES_PATH=/api/v1/camp/services
DOLPHIN_CAMP_ACCOUNTS_PATH=/api/v1/camp/accounts
DOLPHIN_CAMP_ACCOUNTSALES_PATH=/api/v1/camp/accountsales
# Keep business collection disabled until every vendor method and its semantics are confirmed.
DOLPHIN_CAMP_BUSINESS_ENABLED=0
DOLPHIN_CAMP_BUSINESS_LOOKBACK_DAYS=7
DOLPHIN_CAMP_ACCOUNTPAYMENTS_PATH=/api/v1/camp/accountpayments
DOLPHIN_CAMP_SKUDVERIFYLOGS_PATH=/api/v1/camp/skudverifylogs
DOLPHIN_CAMP_CARDS_PATH=/api/v1/camp/cards
DOLPHIN_CAMP_SKUDAREAS_PATH=/api/v1/camp/skudareas
DOLPHIN_CAMP_SKUDCONTROLLERS_PATH=/api/v1/camp/skudcontrollers
DOLPHIN_CAMP_KKMCHEQUES_PATH=/api/v1/camp/kkmcheques
FEEDBACK_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
FEEDBACK_TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
