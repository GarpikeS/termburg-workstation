# Optional production endpoint that accepts JSON order payloads via POST.
VITE_ORDER_API_URL=https://example.com/api/orders

# Optional shared schedule API for a local/desktop installation. The public
# game reads the official WordPress schedules below when this value is absent.
VITE_SCHEDULE_API_URL=https://example.com/api/schedule

# Optional overrides for the official schedules used by the public game.
VITE_MOSCOW_SCHEDULE_URL=https://termburg.ru/wp-json/termburg/v1/schedule
VITE_ZELENOGORSK_SCHEDULE_URL=https://termburg45.ru/wp-json/termburg/v1/schedule
